#!/usr/bin/env bash

set -uo pipefail

WAN_INTERFACE="${WAN_INTERFACE:-lan2}"
FRIENDLYWRT_WAN_MAC="${FRIENDLYWRT_WAN_MAC:-16:c9:1c:42:a5:dc}"
MAC_TEST_FILE="/etc/netplan/90-wan-mac-test.yaml"
OUTPUT_DIR="/home/router"
OUTPUT_FILE="${OUTPUT_DIR}/r6s-diag-$(date +%Y%m%d-%H%M%S).txt"

if (( EUID != 0 )); then
	printf 'Run as root: sudo %s\n' "$0" >&2
	exit 1
fi

install -d -m 0755 "$OUTPUT_DIR"
exec > >(tee "$OUTPUT_FILE") 2>&1

section() {
	printf '\n===== %s =====\n' "$1"
}

has_wan_ipv4() {
	ip -4 -o address show dev "$WAN_INTERFACE" scope global | grep -q .
}

collect_network_state() {
	section "LINKS AND ADDRESSES"
	ip -br link
	ip -br address
	ip route show table all
	ip neigh show

	section "NETWORKD"
	networkctl list --no-pager
	networkctl status "$WAN_INTERFACE" --no-pager --full
	networkctl status br-lan --no-pager --full

	section "BRIDGE"
	bridge -s link show
	bridge fdb show br br-lan
	cat /var/lib/misc/dnsmasq.leases
	for setting in \
		/proc/sys/net/bridge/bridge-nf-call-iptables \
		/proc/sys/net/bridge/bridge-nf-call-ip6tables \
		/proc/sys/net/bridge/bridge-nf-call-arptables; do
		[[ -r "$setting" ]] && printf '%s=' "$setting" && cat "$setting"
	done

	section "WAN LINK"
	printf 'address=' && cat "/sys/class/net/${WAN_INTERFACE}/address"
	printf 'operstate=' && cat "/sys/class/net/${WAN_INTERFACE}/operstate"
	printf 'carrier=' && cat "/sys/class/net/${WAN_INTERFACE}/carrier" 2>&1
	ethtool "$WAN_INTERFACE"
	ethtool -i "$WAN_INTERFACE"
	ethtool -P "$WAN_INTERFACE"
	ethtool --show-eee "$WAN_INTERFACE"
	ethtool -S "$WAN_INTERFACE"

	section "DNS AND CONNECTIVITY"
	resolvectl status
	ping -c 3 -W 2 192.168.0.1
	ping -c 3 -W 2 1.1.1.1
	ping -c 3 -W 2 10.0.0.105
	ping -c 3 -W 2 10.0.0.197
}

section "BASIC"
date -Ins
uname -a
cat /etc/os-release

section "NETPLAN"
netplan get

section "INITIAL STATE"
collect_network_state

section "SERVICES"
systemctl status \
	r6s-router-prepare.service \
	groot-r8125.service \
	systemd-networkd.service \
	systemd-resolved.service \
	dnsmasq.service \
	nftables.service \
	hostapd.service \
	mihomo.service \
	--no-pager --full

section "FIREWALL"
nft list ruleset
sysctl net.ipv4.ip_forward

section "DHCP RENEW"
networkctl renew "$WAN_INTERFACE" || true
sleep 20
collect_network_state

if has_wan_ipv4; then
	section "MAC TEST"
	printf 'Skipped: %s already has an IPv4 address.\n' "$WAN_INTERFACE"
elif [[ "$(cat "/sys/class/net/${WAN_INTERFACE}/carrier" 2>/dev/null || true)" != 1 ]]; then
	section "MAC TEST"
	printf 'Skipped: %s has no physical carrier.\n' "$WAN_INTERFACE"
else
	section "MAC TEST"
	printf 'Testing FriendlyWrt WAN MAC %s on %s.\n' \
		"$FRIENDLYWRT_WAN_MAC" "$WAN_INTERFACE"
	original_mac="$(cat "/sys/class/net/${WAN_INTERFACE}/address")"
	netplan set --origin-hint 90-wan-mac-test \
		"ethernets.${WAN_INTERFACE}.macaddress=${FRIENDLYWRT_WAN_MAC}"
	netplan generate
	networkctl reload
	ip link set "$WAN_INTERFACE" down
	ip link set "$WAN_INTERFACE" address "$FRIENDLYWRT_WAN_MAC"
	ip link set "$WAN_INTERFACE" up
	networkctl reconfigure "$WAN_INTERFACE" || true
	networkctl renew "$WAN_INTERFACE" || true
	sleep 30
	collect_network_state

	if has_wan_ipv4; then
		printf '\nMAC test succeeded; keeping %s for the next boot.\n' "$MAC_TEST_FILE"
	else
		printf '\nMAC test failed; restoring original MAC %s.\n' "$original_mac"
		rm -f "$MAC_TEST_FILE"
		netplan generate
		networkctl reload
		ip link set "$WAN_INTERFACE" down
		ip link set "$WAN_INTERFACE" address "$original_mac"
		ip link set "$WAN_INTERFACE" up
		networkctl reconfigure "$WAN_INTERFACE" || true
	fi
fi

section "NETWORK JOURNAL"
journalctl -b \
	-u r6s-router-prepare.service \
	-u systemd-networkd.service \
	-u systemd-resolved.service \
	-u dnsmasq.service \
	-u nftables.service \
	--no-pager -o short-precise

section "KERNEL JOURNAL"
journalctl -b -k --no-pager -o short-precise

chown router:router "$OUTPUT_FILE" 2>/dev/null || true
chmod 0644 "$OUTPUT_FILE"
sync

section "RESULT"
printf 'Diagnostic report: %s\n' "$OUTPUT_FILE"
