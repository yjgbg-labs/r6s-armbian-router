[Unit]
Description=NanoPi R6S Wi-Fi access point
Requires=r6s-router-prepare.service
After=r6s-router-prepare.service network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/sbin/r6s-router-hostapd
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
