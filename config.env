R6S_ARMBIAN_REPOSITORY="${R6S_ARMBIAN_REPOSITORY:-https://github.com/armbian/build.git}"
R6S_ARMBIAN_REF="${R6S_ARMBIAN_REF:-v26.5.1}"
R6S_ARMBIAN_COMMIT="${R6S_ARMBIAN_COMMIT:-8de11a017f7f05a82c77850f8322928cb6a3b70c}"
R6S_ARTIFACT_VERSION="${R6S_ARTIFACT_VERSION:-$(git rev-parse --short=12 HEAD 2>/dev/null || printf bootstrap)}"
R6S_ARTIFACT_UPLOAD_BASE_URL="${R6S_ARTIFACT_UPLOAD_BASE_URL:-http://s3.yjgbg.lab:9000/public/r6s-armbian-router}"
R6S_ARTIFACT_DOWNLOAD_BASE_URL="${R6S_ARTIFACT_DOWNLOAD_BASE_URL:-http://rustfs.rustfs.svc.cluster.local:9000/public/r6s-armbian-router}"
R6S_MIHOMO_VERSION="${R6S_MIHOMO_VERSION:-1.19.21}"
R6S_MIHOMO_SHA256="${R6S_MIHOMO_SHA256:-d27f6220333fd5d9cb37f64946b3147c3eacf129eb6b4487b7e1e3ab950ff326}"
R6S_R8125_VERSION="${R6S_R8125_VERSION:-9.016.01-paired11}"
R6S_R8125_SOURCE_SHA256="${R6S_R8125_SOURCE_SHA256:-fa974f759c30aef209646f720ecf078f024b50ed9d57a01d5fb394d3a2ef0fd9}"
R6S_R8125_SOURCE_URL="${R6S_R8125_SOURCE_URL:-http://s3.yjgbg.lab:9000/public/r8125/r8125-${R6S_R8125_VERSION}-source.tar.gz}"

export R6S_ARMBIAN_REPOSITORY R6S_ARMBIAN_REF R6S_ARMBIAN_COMMIT
export R6S_ARTIFACT_VERSION R6S_ARTIFACT_UPLOAD_BASE_URL R6S_ARTIFACT_DOWNLOAD_BASE_URL
export R6S_MIHOMO_VERSION R6S_MIHOMO_SHA256
export R6S_R8125_VERSION R6S_R8125_SOURCE_SHA256 R6S_R8125_SOURCE_URL
