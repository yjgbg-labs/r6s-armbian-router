# This file is sourced by scripts/prepare-build.sh and must not be committed.
SSH_AUTHORIZED_KEY_FILE="$HOME/.ssh/id_ed25519.pub"

# Leave disabled for the first wired boot, or set all Wi-Fi values before build.
WIFI_ENABLED=0
WIFI_SSID=""
WIFI_PSK=""
WIFI_COUNTRY=CN
WIFI_CHANNEL=6
WIFI_ENABLE_AX=0

# Preserve the current FriendlyWrt topology: native 1GbE is WAN and both
# PCIe 2.5GbE ports are LAN. Armbian names those ports lan2, lan1 and wan.
WAN_INTERFACE=lan2
LAN_INTERFACE_1=lan1
LAN_INTERFACE_2=wan
LAN_CIDR=10.0.0.1/16
DHCP_START=10.0.0.100
DHCP_END=10.0.0.249
DHCP_LEASE=12h
